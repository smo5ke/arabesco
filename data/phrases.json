[{"theme":"Saudações","arabic":"السَّلَامُ عَلَيْكُمْ","translit":"as-salāmu ʿalaykum","meaning":"Olá / que a paz esteja com vocês","note":"Saudação muito comum."},{"theme":"Saudações","arabic":"وَعَلَيْكُمُ السَّلَامُ","translit":"wa-ʿalaykumu s-salām","meaning":"E que a paz esteja com vocês","note":"Resposta à saudação."},{"theme":"Saudações","arabic":"مَرْحَبًا","translit":"marḥaban","meaning":"Olá","note":"Saudação geral."},{"theme":"Saudações","arabic":"صَبَاحُ الْخَيْرِ","translit":"ṣabāḥu l-khayr","meaning":"Bom dia","note":"Usado de manhã."},{"theme":"Saudações","arabic":"مَسَاءُ الْخَيْرِ","translit":"masāʾu l-khayr","meaning":"Boa tarde / boa noite","note":"Usado da tarde em diante."},{"theme":"Cortesia","arabic":"شُكْرًا","translit":"shukran","meaning":"Obrigado(a)","note":"Não muda conforme o gênero de quem fala."},{"theme":"Cortesia","arabic":"عَفْوًا","translit":"ʿafwan","meaning":"De nada / com licença","note":"O sentido depende da situação."},{"theme":"Cortesia","arabic":"مِنْ فَضْلِكَ","translit":"min faḍlika","meaning":"Por favor","note":"Ao falar com um homem."},{"theme":"Cortesia","arabic":"مِنْ فَضْلِكِ","translit":"min faḍliki","meaning":"Por favor","note":"Ao falar com uma mulher."},{"theme":"Cortesia","arabic":"آسِفٌ","translit":"āsifun","meaning":"Desculpe","note":"Falante masculino; feminino: آسِفَةٌ."},{"theme":"Apresentação","arabic":"مَا اسْمُكَ؟","translit":"mā smuka?","meaning":"Qual é o seu nome?","note":"Ao falar com um homem; para mulher: اسْمُكِ."},{"theme":"Apresentação","arabic":"اسْمِي ...","translit":"ismī ...","meaning":"Meu nome é ...","note":"Complete com seu nome."},{"theme":"Apresentação","arabic":"أَنَا مِنَ الْبَرَازِيلِ","translit":"anā mina l-barāzīl","meaning":"Sou do Brasil","note":"Expressão de origem."},{"theme":"Apresentação","arabic":"أَنَا بَرَازِيلِيٌّ","translit":"anā barāzīliyyun","meaning":"Sou brasileiro","note":"Falante masculino; feminino: بَرَازِيلِيَّةٌ."},{"theme":"Aprendizado","arabic":"أَنَا أَتَعَلَّمُ الْعَرَبِيَّةَ","translit":"anā ataʿallamu l-ʿarabiyya","meaning":"Estou aprendendo árabe","note":"Frase muito útil para iniciantes."},{"theme":"Aprendizado","arabic":"لَا أَفْهَمُ","translit":"lā afhamu","meaning":"Não entendo","note":"Negação com لا."},{"theme":"Aprendizado","arabic":"أَفْهَمُ قَلِيلًا","translit":"afhamu qalīlan","meaning":"Entendo um pouco","note":"Respostas simples."},{"theme":"Aprendizado","arabic":"تَكَلَّمْ بِبُطْءٍ، مِنْ فَضْلِكَ","translit":"takallam bi-buṭʾin, min faḍlika","meaning":"Fale devagar, por favor","note":"Ao falar com um homem."},{"theme":"Aprendizado","arabic":"أَعِدْ، مِنْ فَضْلِكَ","translit":"aʿid, min faḍlika","meaning":"Repita, por favor","note":"Ao falar com um homem."},{"theme":"Aprendizado","arabic":"كَيْفَ أَقُولُ هَذَا بِالْعَرَبِيَّةِ؟","translit":"kayfa aqūlu hādhā bil-ʿarabiyya?","meaning":"Como digo isto em árabe?","note":"Pergunta de estudo."},{"theme":"Essenciais","arabic":"نَعَمْ","translit":"naʿam","meaning":"Sim","note":"Resposta afirmativa."},{"theme":"Essenciais","arabic":"لَا","translit":"lā","meaning":"Não","note":"Resposta negativa."},{"theme":"Essenciais","arabic":"مَنْ؟","translit":"man?","meaning":"Quem?","note":"Pergunta sobre pessoas."},{"theme":"Essenciais","arabic":"مَاذَا؟","translit":"mādhā?","meaning":"O quê?","note":"Pergunta geral."},{"theme":"Essenciais","arabic":"أَيْنَ؟","translit":"ayna?","meaning":"Onde?","note":"Pergunta sobre lugar."},{"theme":"Essenciais","arabic":"مَتَى؟","translit":"matā?","meaning":"Quando?","note":"Pergunta sobre tempo."},{"theme":"Essenciais","arabic":"كَيْفَ؟","translit":"kayfa?","meaning":"Como?","note":"Pergunta sobre maneira."},{"theme":"Cotidiano","arabic":"أُرِيدُ مَاءً","translit":"urīdu māʾan","meaning":"Quero água","note":"Expressão simples."},{"theme":"Cotidiano","arabic":"أَيْنَ الْحَمَّامُ؟","translit":"ayna l-ḥammām?","meaning":"Onde fica o banheiro?","note":"Pergunta prática."},{"theme":"Cotidiano","arabic":"كَمِ السِّعْرُ؟","translit":"kami s-siʿr?","meaning":"Quanto custa?","note":"Pergunta de compra."},{"theme":"Cotidiano","arabic":"إِلَى اللِّقَاءِ","translit":"ilā l-liqāʾ","meaning":"Até logo","note":"Despedida."}]